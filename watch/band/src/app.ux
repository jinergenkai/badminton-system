<script>
export default {
  musicList: [],
  // Today's players from the phone: { v, at, list: [{ i, s, n }] } or null.
  // Persisted as bc_players_v1; loaded by the index page.
  players: null,
  // Settings "Players" switch, persisted as bc_players_on.
  playersOn: false,
  hypeList: [],

  // ── Step-0 diagnostics ────────────────────────────────────────────────
  // console.info on the band is not readable in the field, so every event
  // also lands in this ring buffer. pages/diag renders it on the watch
  // itself, which is the only way to actually read it during a session.
  // Lives on the app object so it survives page navigation — the very
  // thing we are trying to observe.
  // Messages that failed to send because the channel was not open yet.
  // Lives on the app so a page switch does not drop them.
  pendingSends: [],

  diagLog: [],
  openCount: 0,
  closeCount: 0,
  lastReadyStatus: -1,
  sendFailCount: 0,

  logDiag(tag, msg) {
    const d = new Date()
    const p = function (n) { return n < 10 ? '0' + n : '' + n }
    const line = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()) +
      ' [' + tag + '] ' + msg
    console.info('⌚ ' + line)
    // Stored whole. pages/diag wraps it for display — chunking here would come
    // out reversed, since the page lists newest entries first.
    this.diagLog.push(line)
    if (this.diagLog.length > 80) this.diagLog.shift()
  },

  onCreate() {
    console.info('Application onCreate')
  },
  onDestroy() {
    console.info('Application onDestroy')
  }
}
</script>

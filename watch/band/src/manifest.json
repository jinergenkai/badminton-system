{
  "package": "com.hung.bandcounter",
  "name": "Godminton",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1100,
  "icon": "/common/icon.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.app" },
    { "name": "system.router" },
    { "name": "system.prompt" },
    { "name": "system.alarm" },
    { "name": "system.storage" },
    { "name": "system.vibrator" },
    { "name": "system.notification" },
    { "name": "system.configuration" }
  ],
  "permissions": [{ "origin": "*" }],
  "config": {
    "logLevel": "debug",
    "designWidth": 212
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/settings": {
        "component": "settings"
      },
      "pages/media_list": {
        "component": "media_list"
      },
      "pages/diag": {
        "component": "diag"
      },
      "pages/alarm": {
        "component": "alarm"
      },
      "pages/sound": {
        "component": "sound"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}

<template>
  <div class="container">
    <div class="header">
      <text class="title">DIAG</text>
      <div class="clear-btn" onclick="clearLog">
        <text class="clear-text">CLR</text>
      </div>
    </div>

    <div class="summary">
      <text class="summary-line">ready={{ readyStatus }} open={{ openCount }} close={{ closeCount }}</text>
      <text class="summary-line {{ sendFailCount > 0 ? 'bad' : '' }}">sendFail={{ sendFailCount }} lines={{ lines.length }}</text>
    </div>

    <!-- Fixed, outside the list: as list items these scrolled away with the
         log and were simply never seen. -->
    <div class="actions">
      <div class="api-btn" onclick="probeApi">
        <text class="probe-text">1 · LIST API</text>
      </div>
      <div class="probe-btn" onclick="probe">
        <text class="probe-text">2 · TEST SEND</text>
      </div>
    </div>

    <list class="log-list">
      <list-item type="line" for="{{ lines }}" class="row">
        <text class="line-text">{{ $item }}</text>
      </list-item>

      <list-item type="empty" if="{{ lines.length === 0 }}" class="row">
        <text class="line-text">no events yet</text>
      </list-item>

      <list-item type="footer" class="row-footer">
        <text class="line-text">— swipe to go back —</text>
      </list-item>
    </list>
  </div>
</template>

<script>
  import interconnect from '@system.interconnect'
  import prompt from '@system.prompt'

  export default {
    private: {
      lines: [],
      readyStatus: -1,
      openCount: 0,
      closeCount: 0,
      sendFailCount: 0
    },

    diag(msg) {
      const def = this.$app && this.$app.$def
      if (def && def.logDiag) def.logDiag('diag', msg)
    },

    onInit() { this.diag('onInit') },
    onReady() { this.diag('onReady') },

    onShow() {
      this.diag('onShow')
      this.refresh()
    },

    onHide() { this.diag('onHide') },
    onDestroy() { this.diag('onDestroy') },

    refresh() {
      const def = this.$app && this.$app.$def
      if (!def) return
      // Newest first — the interesting event is always the last one.
      const src = def.diagLog || []
      const out = []
      for (let i = src.length - 1; i >= 0; i--) out.push(src[i])
      this.lines = out
      this.readyStatus = def.lastReadyStatus
      this.openCount = def.openCount
      this.closeCount = def.closeCount
      this.sendFailCount = def.sendFailCount
    },

    // Fires a round trip on demand so the link can be tested without having
    // to score a point: readyState is sampled, then a request_sync goes out
    // with both callbacks wired, then the reply (if any) shows up in the log.
    probe() {
      const conn = interconnect.instance()
      if (!conn) {
        this.diag('probe: no instance')
        this.refresh()
        return
      }
      const self = this
      const def = this.$app && this.$app.$def
      conn.getReadyState({
        success: function (data) {
          if (def) def.lastReadyStatus = data.status
          self.diag('probe readyState=' + data.status)
          self.refresh()
        },
        fail: function (data, code) {
          self.diag('probe readyState FAIL code=' + code)
          self.refresh()
        }
      })
      conn.send({
        data: { action: 'request_sync' },
        success: function () {
          self.diag('probe send ok')
          self.refresh()
        },
        fail: function (data, code) {
          if (def) def.sendFailCount++
          self.diag('probe send FAIL code=' + code + ' d=' + JSON.stringify(data))
          self.refresh()
        }
      })
      prompt.showToast({ message: 'Probing...' })
    },

    // The run on 2026-08-23 showed getReadyState=2 with onopen never firing and
    // send() failing locally — i.e. the watch's outbound channel never opens.
    // Nothing in our code ever asks it to. Before guessing, list what the
    // module and the instance actually expose: if there is a connect()/open()
    // we have never called, this is where it shows up.
    probeApi() {
      const names = [
        'instance', 'connect', 'open', 'close', 'send', 'getReadyState',
        'subscribe', 'unsubscribe', 'onopen', 'onclose', 'onmessage', 'onerror',
        'readyState', 'status'
      ]
      const conn = interconnect.instance()

      const describe = (obj, label) => {
        if (!obj) {
          this.diag(label + ': null')
          return
        }
        const found = []
        for (let i = 0; i < names.length; i++) {
          const t = typeof obj[names[i]]
          if (t !== 'undefined') found.push(names[i] + ':' + t)
        }
        this.diag(label + ' has ' + (found.length ? found.join(' ') : '(none)'))
        try {
          const own = Object.getOwnPropertyNames(obj)
          this.diag(label + ' own=' + own.join(','))
        } catch (e) {
          this.diag(label + ' own=<err ' + e.message + '>')
        }
        try {
          const proto = Object.getPrototypeOf(obj)
          if (proto) {
            this.diag(label + ' proto=' + Object.getOwnPropertyNames(proto).join(','))
          }
        } catch (e) {
          this.diag(label + ' proto=<err ' + e.message + '>')
        }
      }

      describe(interconnect, 'module')
      describe(conn, 'instance')
      this.refresh()
      prompt.showToast({ message: 'API probed' })
    },

    clearLog() {
      const def = this.$app && this.$app.$def
      if (def) {
        def.diagLog = []
        def.openCount = 0
        def.closeCount = 0
        def.sendFailCount = 0
      }
      this.refresh()
    }
  }
</script>

<style>
  .container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #0F172A;
  }

  /* The screen is a rounded rectangle: the top ~30px is inside the curve and
     gets clipped by the bezel. Everything on this page starts below that. */
  .header {
    width: 100%;
    height: 84px;
    padding: 30px 14px 0 14px;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .title {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .clear-btn {
    padding: 5px 12px;
    background-color: #FF5252;
    border-radius: 10px;
  }

  .clear-text {
    font-size: 14px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .summary {
    flex-direction: column;
    width: 100%;
    padding: 6px 14px;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .summary-line {
    font-size: 13px;
    color: #4ADE80;
  }

  .bad {
    color: #FF5252;
  }

  .log-list {
    flex: 1;
    width: 100%;
  }

  .row {
    width: 100%;
    padding: 4px 10px;
  }

  .row-footer {
    width: 100%;
    padding: 30px 10px;
  }

  .actions {
    flex-direction: column;
    width: 100%;
    padding: 8px 12px;
  }

  .probe-btn {
    width: 100%;
    height: 42px;
    margin-top: 8px;
    background-color: #8B5CF6;
    border-radius: 12px;
    justify-content: center;
    align-items: center;
  }

  .api-btn {
    width: 100%;
    height: 42px;
    background-color: #0EA5E9;
    border-radius: 12px;
    justify-content: center;
    align-items: center;
  }

  .probe-text {
    font-size: 15px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .line-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
    lines: 2;
    text-overflow: ellipsis;
  }
</style>

<template>
  <div class="container">
    <div class="header">
      <text class="title">MUSIC</text>
      <div class="sync-btn" onclick="requestMediaList">
        <text class="sync-text">SYNC</text>
      </div>
    </div>

    <div class="status-bar">
      <div class="status-dot {{ connected ? 'online' : 'offline' }}"></div>
      <text class="status-text">{{ connected ? 'Connected' : 'Disconnected' }} · {{ musicList.length }} tracks</text>
    </div>

    <list class="media-list">
      <list-item type="control" class="item-control">
        <div class="stop-btn" onclick="stopAll">
          <text class="stop-text">STOP ALL AUDIO</text>
        </div>
      </list-item>

      <list-item type="music" for="{{ musicList }}" class="media-item" onclick="playMusic($item.id)">
        <div class="item-content">
          <text class="item-name">{{ $item.name }}</text>
          <div class="play-icon"></div>
        </div>
      </list-item>

      <list-item type="empty" if="{{ musicList.length === 0 }}" class="empty-item">
        <text class="empty-text">Empty. Tap SYNC to load music.</text>
      </list-item>

      <list-item type="footer" class="list-footer">
        <text class="footer-text">Swipe to go back</text>
      </list-item>
    </list>
  </div>
</template>

<script>
  import interconnect from '@system.interconnect'
  import prompt from '@system.prompt'
  import router from '@system.router'

  export default {
    private: {
      connect: null,
      connected: false,
      musicList: []
    },

    // ── Step-0 diagnostics ───────────────────────────────────────────────
    diag(msg) {
      const def = this.$app && this.$app.$def
      if (def && def.logDiag) def.logDiag('media', msg)
    },

    onInit() {
      this.diag('onInit')
      this.connect = interconnect.instance()
      this.diag('instance=' + (this.connect ? 'ok' : 'NULL'))
    },

    onReady() { this.diag('onReady') },
    onDestroy() { this.diag('onDestroy') },

    onShow() {
      this.diag('onShow')
      this.setupConnect()
      this.syncFromGlobal()
    },

    // If index.ux's onHide runs AFTER this page's onShow, it nulls the handler
    // attached below and the media_list reply lands nowhere. The interleaving
    // of these two log lines is the whole point of this instrumentation.
    onHide() {
      this.diag('onHide: clearing handlers')
      if (this.connect) {
        this.connect.onmessage = null
        this.connect.onopen = null
        this.connect.onclose = null
      }
    },

    syncFromGlobal() {
      if (this.$app.$def.musicList && this.$app.$def.musicList.length > 0) {
        this.musicList = this.$app.$def.musicList
        console.info('⌚ [Media] Loaded from global: ' + this.musicList.length + ' tracks')
      }
    },

    setupConnect() {
      if (!this.connect) return
      this.diag('setupConnect: attaching handlers')

      this.connect.onopen = () => {
        const def = this.$app && this.$app.$def
        if (def) def.openCount++
        this.diag('onopen')
        this.connected = true
        this.requestMediaList()
      }

      this.connect.onclose = () => {
        const def = this.$app && this.$app.$def
        if (def) def.closeCount++
        this.diag('onclose')
        this.connected = false
      }

      this.connect.onmessage = (data) => {
        try {
          const raw = data.data
          // Byte count matters here: the music list is ~2KB and we do not yet
          // know the per-message limit of the transport.
          this.diag('recv ' + (raw ? raw.length : 0) + 'B')
          const msg = JSON.parse(raw)
          this.diag('recv action=' + msg.action)
          if (msg.action === 'media_list') {
            const newList = msg.music || []
            this.diag('media_list: ' + newList.length + ' tracks')
            // Force reactivity: clear then set in next tick
            this.musicList = []
            setTimeout(() => {
              this.musicList = newList
              this.$app.$def.musicList = newList
              prompt.showToast({ message: 'Loaded ' + newList.length + ' tracks' })
            }, 0)
          }
        } catch (e) {
          this.diag('recv PARSE ERROR: ' + e.message)
        }
      }

      // Check ready state and request if connected
      this.connect.getReadyState({
        success: (data) => {
          const def = this.$app && this.$app.$def
          if (def) def.lastReadyStatus = data.status
          this.diag('getReadyState status=' + data.status)
          this.connected = (data.status === 1)
          if (this.connected) this.requestMediaList()
        },
        fail: (data, code) => {
          this.diag('getReadyState FAIL code=' + code)
        }
      })
    },

    sendRaw(payload, toast) {
      if (!this.connect) {
        this.diag('send SKIPPED (no instance): ' + payload.action)
        return
      }
      this.connect.send({
        data: payload,
        success: () => {
          this.diag('send ok: ' + payload.action)
        },
        fail: (data, code) => {
          const def = this.$app && this.$app.$def
          if (def) def.sendFailCount++
          this.diag('send FAIL: ' + payload.action + ' code=' + code +
            ' d=' + JSON.stringify(data))
        }
      })
      if (toast) prompt.showToast({ message: toast })
    },

    requestMediaList() {
      this.sendRaw({ action: 'request_media_list' }, 'Requesting...')
    },

    playMusic(path) {
      this.sendRaw({ action: 'play_music', id: path }, 'Playing')
    },

    stopAll() {
      this.sendRaw({ action: 'stop_all_media' }, 'Stopped')
    }
  }
</script>

<style>
  /* Same fix as pages/diag: height: 100% on a page root does not resolve, so
     the flex: 1 list below computed to zero height and drew nothing — which
     means the track list could never have shown up even when it did arrive. */
  .container {
    flex-direction: column;
    width: 100%;
    background-color: #0F172A;
  }

  /* Same rounded-screen clipping as pages/diag: the SYNC button was sitting
     up inside the bezel curve. */
  .header {
    width: 100%;
    height: 90px;
    padding: 30px 15px 0 15px;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .title {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .sync-btn {
    padding: 6px 15px;
    background-color: #8B5CF6;
    border-radius: 12px;
  }

  .sync-text {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .status-bar {
    width: 100%;
    padding: 8px 15px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
  }

  .online { background-color: #4ADE80; }
  .offline { background-color: #FF5252; }

  .status-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  /* 520 tall screen, less the header (90) and the status bar (~32). */
  .media-list {
    width: 100%;
    height: 395px;
  }

  .item-control {
    width: 100%;
    padding: 15px 15px 5px 15px;
  }

  .stop-btn {
    width: 100%;
    height: 60px;
    background-color: #FF5252;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
  }

  .stop-text {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .media-item {
    padding: 15px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
  }

  .item-content {
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }

  .item-name {
    font-size: 18px;
    color: #E2E8F0;
    flex: 1;
  }

  .play-icon {
    width: 20px;
    height: 20px;
    background-color: #8B5CF6;
    border-radius: 10px;
    margin-left: 10px;
  }

  .empty-item {
    padding: 40px 20px;
    justify-content: center;
  }

  .empty-text {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
  }

  .list-footer {
    padding: 50px 20px;
    justify-content: center;
  }

  .footer-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.2);
    text-align: center;
  }
</style>

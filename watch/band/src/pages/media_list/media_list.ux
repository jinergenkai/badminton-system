<template>
  <div class="container">
    <div class="header">
      <text class="title">MUSIC</text>
      <div class="sync-btn" onclick="requestMediaList">
        <text class="sync-text">SYNC</text>
      </div>
    </div>

    <div class="status-bar">
      <div class="status-dot {{ connected ? 'online' : 'offline' }}"></div>
      <text class="status-text">{{ connected ? 'Connected' : 'Disconnected' }} · {{ musicList.length }} tracks</text>
    </div>

    <list class="media-list">
      <list-item type="control" class="item-control">
        <div class="stop-btn" onclick="stopAll">
          <text class="stop-text">STOP ALL AUDIO</text>
        </div>
      </list-item>

      <list-item type="music" for="{{ musicList }}" class="media-item" onclick="playMusic($item.id)">
        <div class="item-content">
          <text class="item-name">{{ $item.name }}</text>
          <div class="play-icon"></div>
        </div>
      </list-item>

      <list-item type="empty" if="{{ musicList.length === 0 }}" class="empty-item">
        <text class="empty-text">Empty. Tap SYNC to load music.</text>
      </list-item>

      <list-item type="footer" class="list-footer">
        <text class="footer-text">Swipe to go back</text>
      </list-item>
    </list>
  </div>
</template>

<script>
  import interconnect from '@system.interconnect'
  import prompt from '@system.prompt'
  import router from '@system.router'

  export default {
    private: {
      connect: null,
      connected: false,
      musicList: []
    },

    onInit() {
      this.connect = interconnect.instance()
    },

    onShow() {
      this.setupConnect()
      this.syncFromGlobal()
    },

    onHide() {
      if (this.connect) {
        this.connect.onmessage = null
        this.connect.onopen = null
        this.connect.onclose = null
      }
    },

    syncFromGlobal() {
      if (this.$app.$def.musicList && this.$app.$def.musicList.length > 0) {
        this.musicList = this.$app.$def.musicList
        console.info('⌚ [Media] Loaded from global: ' + this.musicList.length + ' tracks')
      }
    },

    setupConnect() {
      if (!this.connect) return

      this.connect.onopen = () => {
        this.connected = true
        console.info('⌚ [Media] Connection opened')
        this.requestMediaList()
      }

      this.connect.onclose = () => {
        this.connected = false
        console.info('⌚ [Media] Connection closed')
      }

      this.connect.onmessage = (data) => {
        try {
          console.info('⌚ [Media] RECV: ' + data.data)
          const msg = JSON.parse(data.data)
          if (msg.action === 'media_list') {
            const newList = msg.music || []
            // Force reactivity: clear then set in next tick
            this.musicList = []
            setTimeout(() => {
              this.musicList = newList
              this.$app.$def.musicList = newList
              prompt.showToast({ message: 'Loaded ' + newList.length + ' tracks' })
            }, 0)
          }
        } catch (e) {
          console.error('⌚ [Media] Parse error: ' + e.message)
        }
      }

      // Check ready state and request if connected
      this.connect.getReadyState({
        success: (data) => {
          this.connected = (data.status === 1)
          if (this.connected) {
            this.requestMediaList()
          } else {
            console.info('⌚ [Media] Not ready, waiting for onopen...')
          }
        }
      })
    },

    requestMediaList() {
      if (!this.connect) return
      console.info('⌚ [Media] Requesting media list...')
      this.connect.send({
        data: { action: 'request_media_list' }
      })
      prompt.showToast({ message: 'Requesting...' })
    },

    playMusic(path) {
      if (!this.connect) return
      this.connect.send({
        data: {
          action: 'play_music',
          id: path
        }
      })
      prompt.showToast({ message: 'Playing' })
    },

    stopAll() {
      if (!this.connect) return
      this.connect.send({
        data: { action: 'stop_all_media' }
      })
      prompt.showToast({ message: 'Stopped' })
    }
  }
</script>

<style>
  .container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #0F172A;
  }

  .header {
    width: 100%;
    height: 60px;
    padding: 0 15px;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .title {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .sync-btn {
    padding: 6px 15px;
    background-color: #8B5CF6;
    border-radius: 12px;
  }

  .sync-text {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .status-bar {
    width: 100%;
    padding: 8px 15px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
  }

  .online { background-color: #4ADE80; }
  .offline { background-color: #FF5252; }

  .status-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  .media-list {
    flex: 1;
    width: 100%;
  }

  .item-control {
    width: 100%;
    padding: 15px 15px 5px 15px;
  }

  .stop-btn {
    width: 100%;
    height: 60px;
    background-color: #FF5252;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
  }

  .stop-text {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .media-item {
    padding: 15px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
  }

  .item-content {
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }

  .item-name {
    font-size: 18px;
    color: #E2E8F0;
    flex: 1;
  }

  .play-icon {
    width: 20px;
    height: 20px;
    background-color: #8B5CF6;
    border-radius: 10px;
    margin-left: 10px;
  }

  .empty-item {
    padding: 40px 20px;
    justify-content: center;
  }

  .empty-text {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
  }

  .list-footer {
    padding: 50px 20px;
    justify-content: center;
  }

  .footer-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.2);
    text-align: center;
  }
</style>

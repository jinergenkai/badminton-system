<template>
  <stack class="root-stack">
    <!-- MAIN GAME UI -->
    <div class="container">
      <!-- ZONE 1: SETTINGS (TOP - 20%) -->
      <div class="settings-area" onclick="openSettings">
        <div class="status-indicator {{ connected ? 'online' : 'offline' }}"></div>
        <text class="settings-label">SETTINGS & SYNC</text>
        <div class="progress-bar">
          <div class="progress-inner" style="width: {{ cooldownProgress }}%"></div>
        </div>
        <text class="clock-text">{{ clockText }}</text>
      </div>

      <!-- ZONE 2 & 3: SCORES (MIDDLE - 60%) -->
      <div class="score-area">
        <!-- TEAM A (LEFT) -->
        <stack class="score-btn card-a" onclick="onScoreA" onlongpress="onQuickHypeA">
          <image src="/common/dog.png" class="score-watermark"></image>
          <div class="score-content {{ isWinnerA ? 'winner-glow' : '' }}">
            <text class="score-text">{{ scoreA }}</text>
          </div>
          <!-- Streak badge: yellow square rotated 45deg, centred on the card's
               inner top corner. The card's overflow:hidden clips 3/4 of it away,
               leaving a triangle. Label is a separate un-rotated layer. -->
          <div class="streak-tri tri-a" if="{{ streakTeam === 'A' && streakCount > 0 }}"></div>
          <text class="streak-text text-a" if="{{ streakTeam === 'A' && streakCount > 0 }}">x{{ streakCount }}</text>
        </stack>

        <!-- TEAM B (RIGHT) -->
        <stack class="score-btn card-b" onclick="onScoreB" onlongpress="onQuickHypeB">
          <image src="/common/cat.png" class="score-watermark"></image>
          <div class="score-content {{ isWinnerB ? 'winner-glow' : '' }}">
            <text class="score-text">{{ scoreB }}</text>
          </div>
          <div class="streak-tri tri-b" if="{{ streakTeam === 'B' && streakCount > 0 }}"></div>
          <text class="streak-text text-b" if="{{ streakTeam === 'B' && streakCount > 0 }}">x{{ streakCount }}</text>
        </stack>
      </div>

      <!-- ZONE 4: UNDO (BOTTOM - 20%) -->
      <div class="undo-area" onclick="onUndo">
        <text class="undo-text">undo</text>
      </div>
    </div>

    <!-- WIN OVERLAY -->
    <div class="win-overlay" if="{{ isWinnerA || isWinnerB }}">
      <stack class="win-container">
        <div class="win-backdrop"></div>
        <div class="win-content">
          <image src="{{ isWinnerA ? '/common/dog.png' : '/common/cat.png' }}" class="win-mascot"></image>
          <text class="win-title">WINNER</text>
          <text class="win-team {{ isWinnerA ? 'color-a' : 'color-b' }}">{{ isWinnerA ? 'TEAM A' : 'TEAM B' }}</text>

          <div class="win-actions">
            <div class="win-btn undo-btn" onclick="onUndo">
              <text class="btn-text">UNDO WIN</text>
            </div>
            <div class="win-btn reset-btn" onclick="resetGame">
              <text class="btn-text">NEXT MATCH</text>
            </div>
          </div>

        </div>
      </stack>
    </div>
  </stack>
</template>

<script>
  import interconnect from '@system.interconnect'
  import prompt from '@system.prompt'
  import router from '@system.router'
  import app from '@system.app'

  export default {
    private: {
      scoreA: 0,
      scoreB: 0,
      history: [],
      connected: false,
      isConnecting: false,
      connect: null,
      isLocked: false,
      cooldownProgress: 0,
      cooldownTimer: null,
      isWinnerA: false,
      isWinnerB: false,
      lastLongPressTime: 0, // Flag to prevent double trigger
      // Consecutive-points streak, owned by the watch so it works with no phone.
      // '' = nobody has scored yet in this match.
      streakTeam: '',
      streakCount: 0,
      clockText: '--:--',
      clockTimer: null,
    },

    onInit() {
      // Keep instance but don't set listeners yet
      this.connect = interconnect.instance()
      this.updateClock()
    },

    onShow() {
      this.setupConnect()
      this.startClock()
    },

    setupConnect() {
      if (!this.connect) return
      
      this.connect.onopen = (data) => {
        this.connected = true
        this.isConnecting = false
        this.requestSync()
      }
      this.connect.onclose = () => {
        this.connected = false
        this.isConnecting = false
      }
      this.connect.onmessage = (data) => {
        try {
          const msg = JSON.parse(data.data)
          
          // Handle media list sync (music only for now, hype postponed)
          if (msg.action === 'media_list') {
            this.$app.$def.musicList = msg.music || []
            console.info('⌚ [Index] Music list updated globally: ' + (msg.music || []).length + ' tracks')
            return
          }

          if (msg.scoreA !== undefined && msg.scoreB !== undefined) {
            // Mirror phone-originated state changes into local history so undo stays aligned
            if (msg.action === 'score_A' || msg.action === 'score_B' || msg.action === 'reset') {
              this.pushHistory()
            } else if (msg.action === 'undo') {
              // Restore the streak that belonged to the state we're rewinding to.
              const prev = this.history.length > 0 ? this.history.pop() : null
              if (prev) {
                this.streakTeam = prev.st
                this.streakCount = prev.sc
              }
            }
            this.scoreA = msg.scoreA
            this.scoreB = msg.scoreB

            if (msg.action === 'score_A') {
              this.bumpStreak('A')
            } else if (msg.action === 'score_B') {
              this.bumpStreak('B')
            } else if (msg.action === 'reset') {
              this.clearStreak()
            } else if (this.scoreA === 0 && this.scoreB === 0) {
              // A plain sync landing on 0-0 means the phone started a new match.
              // For any other sync we can't tell who scored, so leave the streak
              // alone rather than inventing one.
              this.clearStreak()
            }

            this.checkWinner()
            if (msg.action === 'sync' || msg.action === 'manual_sync') {
                prompt.showToast({ message: 'Synced' })
            }
          }
        } catch (e) {}
      }
      
      this.connect.getReadyState({
        success: (data) => {
          this.connected = (data.status === 1)
          if (this.connected) this.requestSync()
        }
      })
    },

    onHide() {
      // Clear listeners to avoid memory leaks or conflicting messages
      if (this.connect) {
        this.connect.onmessage = null
        this.connect.onopen = null
        this.connect.onclose = null
      }
      this.stopClock()
    },

    // ── Clock ────────────────────────────────────────────────────────────
    // 30s tick: the minute shown can lag by up to 30s, which is fine here and
    // costs far less battery than a 1s timer. Only runs while the page is up.
    startClock() {
      this.updateClock()
      if (this.clockTimer) clearInterval(this.clockTimer)
      this.clockTimer = setInterval(() => {
        this.updateClock()
      }, 30000)
    },

    stopClock() {
      if (this.clockTimer) {
        clearInterval(this.clockTimer)
        this.clockTimer = null
      }
    },

    updateClock() {
      const d = new Date()
      const h = d.getHours()
      const m = d.getMinutes()
      this.clockText = (h < 10 ? '0' + h : '' + h) + ':' + (m < 10 ? '0' + m : '' + m)
    },

    // ── History & streak ─────────────────────────────────────────────────
    // Every state mutation snapshots the streak alongside the scores, so undo
    // rewinds "x3" back to "x2" instead of leaving it stuck.
    pushHistory() {
      this.history.push({
        a: this.scoreA,
        b: this.scoreB,
        st: this.streakTeam,
        sc: this.streakCount
      })
      if (this.history.length > 20) this.history.shift()
    },

    bumpStreak(team) {
      if (this.streakTeam === team) {
        this.streakCount++
      } else {
        this.streakTeam = team
        this.streakCount = 1
      }
    },

    clearStreak() {
      this.streakTeam = ''
      this.streakCount = 0
    },

    requestSync() {
      if (!this.connect) return
      this.connect.send({
        data: { action: 'request_sync' }
      })
      // Also request media list on connection
      this.connect.send({
        data: { action: 'request_media_list' }
      })
      prompt.showToast({ message: 'Sync Requested' })
    },

    resetGame() {
      // Save current state to history so we can UNDO the reset
      this.pushHistory()

      this.scoreA = 0
      this.scoreB = 0
      this.clearStreak()
      this.isWinnerA = false
      this.isWinnerB = false
      this.sendUpdate('reset', true)
      prompt.showToast({ message: 'New Match Started' })
    },

    openSettings() {
      router.push({
        uri: 'pages/settings',
        params: {
          connected: this.connected,
          scoreA: this.scoreA,
          scoreB: this.scoreB
        }
      })
    },

    openMediaList() {
      router.push({
        uri: 'pages/media_list',
        params: {
          connected: this.connected
        }
      })
    },

    checkWinner() {
      this.isWinnerA = false
      this.isWinnerB = false
      if ((this.scoreA >= 21 && (this.scoreA - this.scoreB) >= 2) || this.scoreA === 30) {
        this.isWinnerA = true
      } else if ((this.scoreB >= 21 && (this.scoreB - this.scoreA) >= 2) || this.scoreB === 30) {
        this.isWinnerB = true
      }
    },

    startCooldown() {
      if (this.cooldownTimer) clearInterval(this.cooldownTimer)
      this.isLocked = true
      this.cooldownProgress = 100
      this.cooldownTimer = setInterval(() => {
        if (this.cooldownProgress > 0) this.cooldownProgress -= 10
        else this.stopCooldown()
      }, 50)
    },

    stopCooldown() {
      if (this.cooldownTimer) { clearInterval(this.cooldownTimer); this.cooldownTimer = null }
      this.isLocked = false
      this.cooldownProgress = 0
    },

    onScoreA() {
      // If a long press was just handled, ignore the click (release)
      if (Date.now() - this.lastLongPressTime < 500) return
      
      if (this.isLocked || this.isWinnerA || this.isWinnerB) return
      this.pushHistory()
      this.scoreA++
      this.bumpStreak('A')
      this.sendUpdate('score_A')
    },

    onScoreB() {
      if (Date.now() - this.lastLongPressTime < 500) return

      if (this.isLocked || this.isWinnerA || this.isWinnerB) return
      this.pushHistory()
      this.scoreB++
      this.bumpStreak('B')
      this.sendUpdate('score_B')
    },

    onQuickHypeA() {
      if (this.isLocked || this.isWinnerA || this.isWinnerB) return
      this.lastLongPressTime = Date.now()
      this.pushHistory()
      this.scoreA++
      this.bumpStreak('A')
      this.sendUpdate('score_A', false, 'manual_trigger')
      prompt.showToast({ message: 'Point + Nice Pair!' })
    },

    onQuickHypeB() {
      if (this.isLocked || this.isWinnerA || this.isWinnerB) return
      this.lastLongPressTime = Date.now()
      this.pushHistory()
      this.scoreB++
      this.bumpStreak('B')
      this.sendUpdate('score_B', false, 'manual_trigger')
      prompt.showToast({ message: 'Point + Nice Pair!' })
    },

    onUndo() {
      if (this.isLocked || this.history.length === 0) return
      const lastState = this.history.pop()
      this.scoreA = lastState.a
      this.scoreB = lastState.b
      this.streakTeam = lastState.st
      this.streakCount = lastState.sc
      this.sendUpdate('undo')
    },

    sendUpdate(action, isReset = false, manualHype = null) {
      this.checkWinner()
      this.startCooldown()
      if (!this.connect) return
      this.connect.send({
        data: {
          action: action,
          scoreA: this.scoreA,
          scoreB: this.scoreB,
          reset: isReset,
          manualHype: manualHype,
          // index.ux always mutates local state before sending; phone must NOT echo back
          // (otherwise we'd double-push history). Settings page omits this so phone echoes.
          silent: true,
          timestamp: Date.now(),
        }
      })
    }
  }
</script>

<style>
  .root-stack {
    width: 100%;
    height: 100%;
    background-color: #0F172A;
  }

  .container {
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  /* ZONE 1: SETTINGS Area (20%) */
  .settings-area {
    width: 100%;
    height: 100px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-bottom: 6px;
  }

  .online { background-color: #448AFF; }
  .offline { background-color: #FF5252; }

  .settings-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: bold;
  }

  .progress-bar {
    width: 100px;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 8px;
  }

  .progress-inner {
    height: 100%;
    background-color: #448AFF;
  }

  .clock-text {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
    margin-top: 6px;
  }

  /* ZONE 2 & 3: SCORES Area (60%) */
  .score-area {
    flex: 1;
    width: 100%;
    flex-direction: row;
    padding: 8px;
  }

  .score-btn {
    flex: 1;
    height: 100%;
    margin: 4px;
    border-radius: 20px;
    overflow: hidden;
  }

  .card-a { background-color: #FF5252; }
  .card-b { background-color: #448AFF; }

  .score-watermark {
    width: 80%;
    height: 80%;
    object-fit: contain;
    opacity: 0.25;
    position: absolute;
    bottom: -15px;
    align-self: center;
  }

  .score-content {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
  }

  .score-text {
    font-size: 65px;
    font-weight: bold;
    color: #FFFFFF;
    text-shadow: 0px 4px 10px rgba(0,0,0,0.3);
  }

  /* STREAK BADGE
     68px square rotated 45deg, centre pinned to the card's inner top corner
     (offset = -68/2). Three quarters fall outside the card and are removed by
     .score-btn's overflow:hidden, so what shows is a right triangle with ~48px
     legs tucked into the corner. */
  .streak-tri {
    position: absolute;
    width: 68px;
    height: 68px;
    background-color: #FBBF24;
    transform: rotate(45deg);
  }

  .tri-a { top: -34px; right: -34px; }
  .tri-b { top: -34px; left: -34px; }

  .streak-text {
    position: absolute;
    font-size: 17px;
    font-weight: bold;
    color: #0F172A;
  }

  .text-a { top: 4px; right: 6px; }
  .text-b { top: 4px; left: 6px; }

  /* ZONE 4: UNDO Area (20%) */
  .undo-area {
    width: 100%;
    height: 100px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .undo-text {
    color: rgba(255, 255, 255, 0.3);
    font-size: 32px;
    font-weight: bold;
  }

  /* WIN OVERLAY */
  .win-overlay {
    width: 100%;
    height: 100%;
  }

  .win-container {
    width: 100%;
    height: 100%;
  }

  .win-backdrop {
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.98);
  }

  .win-content {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .win-mascot {
    width: 130px;
    height: 130px;
    object-fit: contain;
    margin-bottom: 8px;
  }

  .win-title {
    color: rgba(255, 255, 255, 0.5);
    font-size: 22px;
    font-weight: bold;
  }

  .win-team {
    font-size: 38px;
    font-weight: 900;
    margin-bottom: 24px;
  }

  .color-a { color: #FF5252; }
  .color-b { color: #448AFF; }

  .win-actions {
    flex-direction: column;
    width: 100%;
    align-items: center;
  }

  .win-btn {
    width: 170px;
    height: 54px;
    border-radius: 27px;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
  }

  .reset-btn { background-color: #FF5252; }
  .undo-btn { background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); }

  .btn-text {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
  }
</style>

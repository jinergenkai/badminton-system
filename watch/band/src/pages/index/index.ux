    flex-direction: column;
    padding: 10px;
  }

  .win-top {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .card-title {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .card-score {
    font-size: 44px;
    font-weight: bold;
    color: #FFFFFF;
    margin-top: 4px;
  }

  /* Lower half of the card, full width: easy to hit on the way out. */
  .done-btn {
    width: 100%;
    height: 120px;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.35);

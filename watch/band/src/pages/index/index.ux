  }

  .home-row { flex-direction: row; align-items: center; height: 40px; }
  .home-score { font-size: 34px; font-weight: bold; }
  .home-dash { font-size: 28px; color: rgba(255, 255, 255, 0.5); margin: 0 10px; }
  .home-red { height: 26px; color: #FF7A7A; font-size: 18px; font-weight: bold; }
  .home-blue { height: 26px; color: #7AAEFF; font-size: 18px; font-weight: bold; }

  /* WIN: one rounded card where the two score cards are; the undo bar
     below is the board's own. */
  .mid-area {
    flex: 1;
    width: 100%;
    padding: 8px;
  }

  .big-card {
    flex: 1;
    height: 100%;
    margin: 4px;
    border-radius: 20px;
    overflow: hidden;
  }

  .win-col {

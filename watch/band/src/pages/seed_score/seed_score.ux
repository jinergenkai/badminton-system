<template>
  <!-- No BACK button: the band's own edge swipe already goes back. -->
  <div class="page">
    <text class="title t-blue" if="{{ step === 0 }}">BLUE SCORE</text>
    <text class="title t-red" if="{{ step === 1 }}">RED SCORE</text>
    <text class="title" if="{{ step === 2 }}">WHO SERVES?</text>

    <list class="numbers" if="{{ step < 2 }}">
      <list-item type="score" for="{{ numbers }}" class="number-row" onclick="chooseScore($idx)">
        <text class="number">{{ $item }}</text>
      </list-item>
    </list>

    <div class="serve red" if="{{ step === 2 }}" onclick="chooseServe('A')"><text class="serve-text">RED SERVES</text></div>
    <div class="serve blue" if="{{ step === 2 }}" onclick="chooseServe('B')"><text class="serve-text">BLUE SERVES</text></div>
  </div>
</template>

<script>
  import router from '@system.router'

  export default {
    private: { step: 0, blue: 0, red: 0, numbers: [] },
    onInit() {
      const n = []
      for (let i = 0; i <= 30; i++) n.push(i)
      this.numbers = n
    },
    // $idx, not $item: the proven pattern (alarm.ux). numbers[i] === i.
    chooseScore(value) {
      if (this.step === 0) { this.blue = value; this.step = 1 }
      else { this.red = value; this.step = 2 }
    },
    chooseServe(team) {
      const def = this.$app && this.$app.$def
      if (def) def.pendingMatchCommand = {
        action: 'seed_score', scoreA: this.red, scoreB: this.blue, servingTeam: team
      }
      router.back()
    },
  }
</script>

<style>
  .page { flex-direction: column; width: 100%; background-color: #0F172A; padding: 30px 8px 0 8px; }
  .title { width: 100%; height: 52px; color: #FFFFFF; font-size: 24px; font-weight: bold; text-align: center; }
  .t-blue { color: #448AFF; }
  .t-red { color: #FF5252; }
  .numbers { width: 100%; height: 410px; }
  .number-row { width: 100%; height: 76px; margin-bottom: 8px; justify-content: center; align-items: center; background-color: rgba(255,255,255,0.08); border-radius: 14px; }
  .number { color: #FFFFFF; font-size: 34px; font-weight: bold; }
  .serve { width: 100%; height: 120px; margin-top: 16px; justify-content: center; align-items: center; border-radius: 18px; }
  .red { background-color: #FF5252; }
  .blue { background-color: #448AFF; }
  .serve-text { color: #FFFFFF; font-size: 22px; font-weight: bold; }
</style>

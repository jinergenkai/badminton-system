<template>
  <div class="page">
    <div class="header"><text class="title">LAST 20 SETS</text></div>
    <text class="empty" if="{{ rows.length === 0 }}">{{ emptyText }}</text>
    <list class="history-list" if="{{ rows.length > 0 }}">
      <!-- One type, one structure for every row (no if/else inside list-item:
           no precedent on this band). A set without names gets '' in the
           name lines and a shorter height through the style binding. -->
      <list-item type="match" for="{{ rows }}" class="record" style="height: {{ $item.h }}px">
        <div class="line">
          <text class="num">{{ $item.n }}</text>
          <text class="red">{{ $item.a }}</text>
          <text class="dash">-</text>
          <text class="blue">{{ $item.b }}</text>
          <text class="status">{{ $item.status }}</text>
        </div>
        <text class="meta">{{ $item.meta }}</text>
        <!-- Name lines are 0px tall on an unnamed set. Leaving them at 24px
             inside a 72px card made flexbox squeeze every line to fit, which
             cut the meta line in half and left the lower half blank. -->
        <div class="names" style="height: {{ $item.nh }}px">
          <text class="nm-red">{{ $item.r1 }}</text>
          <text class="vs">{{ $item.x }}</text>
          <text class="nm-blue">{{ $item.b1 }}</text>
        </div>
        <div class="names" style="height: {{ $item.nh }}px">
          <text class="nm-red">{{ $item.r2 }}</text>
          <text class="vs"></text>
          <text class="nm-blue">{{ $item.b2 }}</text>
        </div>
      </list-item>
    </list>
    <!-- Swipe right goes back, like every page: this button filters instead. -->
    <div class="filter {{ doneOnly ? 'filter-on' : '' }}" onclick="onToggle">
      <text class="filter-text {{ doneOnly ? 'filter-text-on' : '' }}">{{ filterText }}</text>
    </div>
  </div>
</template>

<script>
  import storage from '@system.storage'

  function pad(n) { return n < 10 ? '0' + n : '' + n }

  // Everything the template shows is precomputed here: calling methods
  // from `{{ }}` has no precedent on this band and is exactly the kind of
  // thing that renders as nothing (docs/watch-ui-gotchas.md).
  // Stored newest first, so position 0 is #1 = the most recent set.
  function toRow(r, i) {
    let when = '--:--'
    if (r.startedAt) {
      const d = new Date(r.startedAt)
      when = pad(d.getHours()) + ':' + pad(d.getMinutes())
    }
    let dur = '--'
    if (r.startedAt && r.endedAt) {
      const s = Math.max(0, Math.floor((r.endedAt - r.startedAt) / 1000))
      dur = Math.floor(s / 60) + 'm'
      if (r.seededScoreA >= 0) dur = '~' + dur
    }
    const synced = r.syncedRev === r.revision ? ' · SYNCED' : ''
    const lu = r.lu
    const nm = (id) => (lu && lu.names && lu.names[id] && lu.names[id].s) || ''
    const named = !!(lu && lu.red && lu.blue)
    return {
      h: named ? 126 : 72,
      nh: named ? 24 : 0,
      r1: named ? nm(lu.red[0]) : '',
      r2: named ? nm(lu.red[1]) : '',
      b1: named ? nm(lu.blue[0]) : '',
      b2: named ? nm(lu.blue[1]) : '',
      x: named ? 'x' : '',
      n: '#' + (i + 1),
      a: '' + r.scoreA,
      b: '' + r.scoreB,
      status: r.status === 'completed' ? 'DONE' : 'STOP',
      meta: when + ' · ' + dur + synced
    }
  }

  export default {
    // Finished sets by default, like the phone's history; the choice is kept
    // for the session in $def. Numbers count within what is shown.
    private: { rows: [], all: [], doneOnly: true, filterText: 'DONE ONLY', emptyText: 'NO SETS YET' },

    onShow() {
      const def = this.$app && this.$app.$def
      if (def && def.historyDoneOnly === false) this.doneOnly = false
      if (def && def.matchHistory) {
        this.all = def.matchHistory
        this.apply()
        return
      }
      storage.get({
        key: 'bc_match_history_v2',
        success: (raw) => {
          let list = []
          try { list = raw ? JSON.parse(raw) : [] } catch (e) { list = [] }
          this.all = list
          this.apply()
        },
        fail: () => { this.all = []; this.apply() }
      })
    },

    apply() {
      const list = this.doneOnly ? this.all.filter((r) => r.status === 'completed') : this.all
      this.rows = list.map(toRow)
      this.filterText = this.doneOnly ? 'DONE ONLY' : 'ALL SETS'
      this.emptyText = this.all.length === 0 ? 'NO SETS YET' : 'NO FINISHED SETS'
    },

    onToggle() {
      this.doneOnly = !this.doneOnly
      const def = this.$app && this.$app.$def
      if (def) def.historyDoneOnly = this.doneOnly
      this.apply()
    }
  }
</script>

<style>
  .page { flex-direction: column; width: 100%; background-color: #0F172A; padding: 28px 16px 0 16px; }
  .header { height: 48px; justify-content: center; align-items: center; }
  .title { color: #FFFFFF; font-size: 20px; font-weight: bold; }
  .history-list { width: 100%; height: 360px; }
  .record { width: 100%; height: 72px; margin-bottom: 8px; padding: 8px 12px; flex-direction: column; background-color: rgba(255,255,255,0.08); border-radius: 12px; }
  .line { width: 100%; height: 30px; flex-shrink: 0; flex-direction: row; align-items: center; }
  .num { color: #FFFFFF; font-size: 18px; font-weight: bold; width: 44px; }
  .red { color: #FF5252; font-size: 22px; font-weight: bold; }
  .dash { color: #94A3B8; font-size: 22px; margin-left: 6px; margin-right: 6px; }
  .blue { color: #448AFF; font-size: 22px; font-weight: bold; }
  .status { color: #94A3B8; font-size: 13px; margin-left: 12px; }
  .meta { color: #CBD5E1; font-size: 14px; height: 20px; flex-shrink: 0; margin-top: 4px; }
  /* Red on the left, blue on the right: same sides as the score cards. */
  .names { width: 100%; height: 24px; flex-shrink: 0; overflow: hidden; flex-direction: row; align-items: center; }
  .nm-red { width: 45%; height: 24px; color: #FF7A7A; font-size: 17px; font-weight: bold; }
  .vs { width: 10%; height: 24px; color: #94A3B8; font-size: 14px; text-align: center; }
  .nm-blue { width: 45%; height: 24px; color: #7AAEFF; font-size: 17px; font-weight: bold; text-align: right; }
  .empty { width: 100%; height: 360px; color: #64748B; font-size: 15px; text-align: center; }
  .filter { width: 100%; height: 44px; margin-top: 4px; justify-content: center; align-items: center; border-radius: 22px; border-width: 2px; border-color: #475569; }
  .filter-on { border-color: #FFC107; background-color: rgba(255,193,7,0.15); }
  .filter-text { color: #CBD5E1; font-size: 15px; font-weight: bold; }
  .filter-text-on { color: #FFC107; }
</style>

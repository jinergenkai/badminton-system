<template>
  <!-- Opened from the start screen (PICK PLAYERS). Swiping back out of it
       starts nothing. -->
  <div class="page">
    <!-- Steps 1-4: pick one player each -->
    <text class="title t-blue" if="{{ step === 1 }}">Blue 1</text>
    <text class="title t-blue" if="{{ step === 2 }}">Blue 2</text>
    <text class="title t-red" if="{{ step === 3 }}">Red 1</text>
    <text class="title t-red" if="{{ step === 4 }}">Red 2</text>
    <list class="pick-list" if="{{ step >= 1 && step <= 4 }}">
      <!-- One type, identical structure: `full` is '' when it would repeat. -->
      <list-item type="pick" for="{{ rows }}" class="pick-row" onclick="onPick($idx)">
        <text class="pick-short">{{ $item.s }}</text>
        <text class="pick-full">{{ $item.full }}</text>
      </list-item>
    </list>
    <!-- No server / receiver step: who plays whom is what history needs, and
         a wrong pick there spoiled every serve stat after it. -->
  </div>
</template>

<script>
  import router from '@system.router'

  export default {
    private: {
      step: 1,
      rows: [],
      // Working state. Declared here, not assigned ad hoc on `this`: the
      // framework only keeps what is declared (see the Sound page bug).
      all: [],
      names: {},
      blue: [],
      red: []
    },

    onInit() {
      const def = this.$app && this.$app.$def
      const all = (def && def.players && def.players.list) || []
      const names = {}
      for (let i = 0; i < all.length; i++) names[all[i].i] = { s: all[i].s, n: all[i].n }
      this.all = all
      this.names = names
      this.buildRows()
    },

    short(id) { return (this.names[id] && this.names[id].s) || '?' },

    buildRows() {
      const taken = this.blue.concat(this.red)
      const rows = []
      for (let i = 0; i < this.all.length; i++) {
        const p = this.all[i]
        if (taken.indexOf(p.i) >= 0) continue
        rows.push({ i: p.i, s: p.s, full: p.n && p.n !== p.s ? p.n : '' })
      }
      this.rows = rows
    },

    onPick(idx) {
      const row = this.rows[idx]
      if (!row) return
      if (this.step <= 2) this.blue = this.blue.concat([row.i])
      else this.red = this.red.concat([row.i])
      if (this.step < 4) {
        this.step = this.step + 1
        this.buildRows()
      } else {
        this.finish()
      }
    },

    finish() {
      const def = this.$app && this.$app.$def
      const ids = this.red.concat(this.blue)
      const names = {}
      for (let i = 0; i < ids.length; i++) names[ids[i]] = this.names[ids[i]]
      if (def) def.pendingMatchCommand = {
        action: 'set_lineup',
        lu: {
          red: this.red.slice(),
          blue: this.blue.slice(),
          // Name snapshot: records stay readable after renames/removals.
          names: names
        }
      }
      router.back()
    }
  }
</script>

<style>
  .page { flex-direction: column; width: 100%; background-color: #0F172A; padding: 30px 8px 0 8px; }
  .title { width: 100%; height: 52px; color: #FFFFFF; font-size: 24px; font-weight: bold; text-align: center; }
  .t-blue { color: #448AFF; }
  .t-red { color: #FF5252; }
  .pick-list { width: 100%; height: 410px; }
  .pick-row { width: 100%; height: 76px; margin-bottom: 8px; padding: 6px 14px; flex-direction: column; justify-content: center; background-color: rgba(255,255,255,0.08); border-radius: 14px; }
  .pick-short { color: #FFFFFF; font-size: 26px; font-weight: bold; height: 34px; }
  .pick-full { color: #94A3B8; font-size: 13px; height: 18px; }
</style>
